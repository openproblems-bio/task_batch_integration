// Nextflow resource config for the de.NBI Berlin BiBiGrid SLURM cluster.
// de.NBI analog of labels_tw.config (which targets AWS Batch).
//
// Cluster shape it assumes: CPU workers `spatialhack-large` = 64 vCPU / ~490 GB usable, in SLURM
// partition `cpu`; on-demand single-T4 GPU workers in partition `gpu` (see the GPU section in README).

def exitStrat(task, max_attempts = 3) {
  println "Determining exit strategy for task (attempt '${task.attempt}', exit status '${task.exitStatus}')"
  // ignore the error after 3 attempts so the benchmark continues past a failing component
  if (task.attempt >= 3) {
    return 'ignore'
  }
  // odd / unknown exit codes (e.g. node reclaim) -> retry
  if (task.exitStatus == null || task.exitStatus <= -1 || task.exitStatus > 2100000000 || !(task.exitStatus.toString().isNumber())) {
    return 'retry'
  }
  // component failed -> retry once
  if (task.exitStatus == 1 && task.attempt < 2) {
    return 'retry'
  }
  // out of memory (OOM/segfault) -> retry with more memory
  if (task.exitStatus in [137, 139] && task.attempt < max_attempts) {
    return 'retry'
  }
  return 'ignore'
}

// SLURM (unlike AWS Batch) does not manage containers itself, so enable Docker explicitly.
// Workers already have Docker installed by BiBiGrid.
docker {
  enabled = true
  // Containers run as their built-in user (root). Do NOT add `-u $(id -u):$(id -g)` here: R methods
  // (lm, knnr_r, cellmapper_linear) bridge to Python via reticulate, and running as an arbitrary
  // non-root UID (no HOME) makes reticulate resolve the wrong interpreter
}

process {
  executor = 'slurm'
  queue = 'cpu'          // default CPU partition; the GPU tiers below override this to `gpu`.

  // Never let SLURM silently REQUEUE a job whose (cloud) node died
  clusterOptions = '--no-requeue'

  errorStrategy = { exitStrat(task) }
  maxRetries = 3
  // Cap requested memory at a worker's usable RAM. A --mem request larger than any node would stay
  // PENDING forever in SLURM; get_memory() below clamps to process.maxMemory.
  maxMemory = 480.GB

  // --- CPU + memory tiers (same numbers as labels_tw.config; all fit a 64-vCPU / ~490 GB node) ---
  withLabel: lowcpu  { cpus = 5 }
  withLabel: midcpu  { cpus = 15 }
  withLabel: highcpu { cpus = 30 }
  withLabel: lowmem      { memory = { get_memory( 20.GB  * task.attempt ) } }
  withLabel: midmem      { memory = { get_memory( 50.GB  * task.attempt ) } }
  withLabel: highmem     { memory = { get_memory( 100.GB * task.attempt ) } }
  withLabel: veryhighmem { memory = { get_memory( 200.GB * task.attempt ) } }

  // shared memory (/dev/shm) sizing, as a fraction of the task's memory (Docker only)
  withLabel: lowsharedmem  { containerOptions = { workflow.containerEngine != 'singularity' ? "--shm-size ${String.format("%.0f", task.memory.mega * 0.05)}" : "" } }
  withLabel: midsharedmem  { containerOptions = { workflow.containerEngine != 'singularity' ? "--shm-size ${String.format("%.0f", task.memory.mega * 0.1)}"  : "" } }
  withLabel: highsharedmem { containerOptions = { workflow.containerEngine != 'singularity' ? "--shm-size ${String.format("%.0f", task.memory.mega * 0.25)}" : "" } }

  // --- GPU tiers ---
  // de.NBI Berlin has exactly two GPU flavors, both carrying a SINGLE T4 (pci_passthrough alias T4:1):
  //   de.NBI GPU T4 medium — 16 vCPU /  64 GB  ->  midgpu
  //   de.NBI GPU T4 large  — 32 vCPU / 128 GB  ->  gpu, highgpu, biggpu
  withLabel: gpu {
    cpus = 32
    memory = 115.GB
    accelerator = 1
    queue = 'gpu'
    containerOptions = { workflow.containerEngine == 'docker' ? '--gpus all --ipc=host' : ( workflow.containerEngine == 'singularity' ? '--nv' : null ) }
  }
  withLabel: midgpu {
    cpus = 16
    memory = 50.GB
    accelerator = 1
    queue = 'gpu'
    containerOptions = { workflow.containerEngine == 'docker' ? '--gpus all --ipc=host' : ( workflow.containerEngine == 'singularity' ? '--nv' : null ) }
  }
  withLabel: highgpu {
    cpus = 32
    memory = 115.GB
    accelerator = 1
    queue = 'gpu'
    containerOptions = { workflow.containerEngine == 'docker' ? '--gpus all --ipc=host' : ( workflow.containerEngine == 'singularity' ? '--nv' : null ) }
  }
  // Nothing here has more VRAM than a 16 GB T4, so biggpu falls back to the large node — a method that
  // really needs a bigger card will OOM rather than land on one.
  withLabel: biggpu {
    cpus = 32
    memory = 115.GB
    accelerator = 1
    queue = 'gpu'
    containerOptions = { workflow.containerEngine == 'docker' ? '--gpus all --ipc=host' : ( workflow.containerEngine == 'singularity' ? '--nv' : null ) }
  }

  // make sure the state-publishing process gets enough memory
  withName: '.*publishStatesProc' {
    memory = 16.GB
  }
}

// Clamp a requested memory value to process.maxMemory (so no job requests more RAM than a node has).
def get_memory(to_compare) {
  if (!process.containsKey("maxMemory") || !process.maxMemory) {
    return to_compare
  }
  def maxMem = process.maxMemory as nextflow.util.MemoryUnit
  return to_compare.compareTo(maxMem) > 0 ? maxMem : to_compare
}

// tracing file next to the results
trace {
  enabled = true
  overwrite = true
  file = "${params.publish_dir}/trace.txt"
}
